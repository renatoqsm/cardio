{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cardio",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "0d1443f965a946a8895d12f758e1078b"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "STORAGE_BACKEND": "supabase",
    "SUPABASE_STORAGE_BUCKET": "cardio-proofs",
    "BETTER_AUTH_URL": "https://cardio.renatoqsousam.workers.dev",
    "SUPABASE_URL": "https://qysdfwnbrsllrdjrmwgl.supabase.co",
    "BILLING_ENABLED": "false",
    "ASAAS_ENVIRONMENT": "production",
    "VAPID_PUBLIC_KEY": "BLRd7P-zVWSPdU5z_rFrClIbHUBj2W0rnBbe1kQn7L6GzDn-Lm9X6uITRzUZ_yLDMSAo1ONiT-06u1Mxr3lA39g",
    "VAPID_SUBJECT": "https://cardio.renatoqsousam.workers.dev",
    "SITE_URL": "https://www.desafiopulso.online"
  },
  "routes": [
    {
      "pattern": "www.desafiopulso.online",
      "custom_domain": true,
      "zone_id": "2d7f4062d64e33f1b80f5d1171ef25af"
    },
    {
      "pattern": "desafiopulso.online",
      "custom_domain": true,
      "zone_id": "2d7f4062d64e33f1b80f5d1171ef25af"
    }
  ]
}
